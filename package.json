{
  "name": "@mark_future_ai/dsh-quota-meter",
  "version": "0.1.0",
  "description": "DeepSeek Harness usage pill: provider balance, subscription plan meters (OpenCode Go) and per-session cost in the composer dock row.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "usage",
    "cost",
    "balance",
    "quota",
    "subscription",
    "opencode-go"
  ],
  "author": "atlasmarkz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atlasmarkz/dsh-quota-meter.git"
  },
  "homepage": "https://github.com/atlasmarkz/dsh-quota-meter#readme",
  "bugs": {
    "url": "https://github.com/atlasmarkz/dsh-quota-meter/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
